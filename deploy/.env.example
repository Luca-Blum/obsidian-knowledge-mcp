# Copy to .env on the Pi and fill in. .env is never committed.

# Image published by CI
IMAGE=ghcr.io/luca-blum/obsidian-knowledge-mcp:latest

# Postgres
POSTGRES_PASSWORD=change-me

# Ollama embedding model, and the vector dimension it produces
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# Engineering Collection
ENGINEERING_VAULT_DIR=/srv/vaults/Engineering
ENGINEERING_MCP_PORT=8081
ENGINEERING_HEAP=-Xmx512m
ENGINEERING_SEARCH_TOOL_DESCRIPTION="Searches the User's engineering Collection (Obsidian Notes and Source Notes). 'query' is the question in your own words (vector search, works across German and English). Set 'topic' when the subject is clear. Cite the Note path of every hit you use."
