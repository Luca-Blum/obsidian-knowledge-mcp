# Copy to .env on the Pi and fill in. .env is never committed.

# Image published by CI
IMAGE=ghcr.io/luca-blum/obsidian-knowledge-mcp:latest

# Postgres superuser, used only by the postgres-init service
POSTGRES_PASSWORD=change-me

# Ollama embedding model, and the vector dimension it produces
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
# How long the service waits for one embedding. The Pi's CPU needs several seconds per chunk
OLLAMA_TIMEOUT=120s

# Engineering Collection
ENGINEERING_VAULT_DIR=/srv/vaults/Engineering
ENGINEERING_MCP_PORT=8081
ENGINEERING_HEAP=-Xmx512m
# Password of the database role "engineering", named like the schema, which sees only that schema
ENGINEERING_DB_PASSWORD=change-me
# One bearer token per client (openssl rand -hex 32). Leave one empty to lock that client out; at least one must be set
ENGINEERING_TOKEN_CLAUDE_AI=
ENGINEERING_TOKEN_CLAUDE_CODE=
# Cosine similarity a Chunk must reach to count as relevant. Belongs to EMBEDDING_MODEL: calibrate it with Negative Questions
ENGINEERING_SEARCH_MINIMUM_SIMILARITY=0.5
ENGINEERING_SEARCH_TOOL_DESCRIPTION="Searches the User's engineering Collection (Obsidian Notes and Source Notes). 'query' is the question in your own words (vector search, works across German and English). 'keywords' are optional exact terms for the full-text search (class names, abbreviations, proper names), all of which must occur; without them the full-text search uses 'query'. Set 'topic' when the subject is clear. Cite the Note path of every hit you use."

# Training Collection
TRAINING_VAULT_DIR=/srv/vaults/Training
TRAINING_MCP_PORT=8082
TRAINING_HEAP=-Xmx512m
# Password of the database role "training", named like the schema, which sees only that schema
TRAINING_DB_PASSWORD=change-me
# One bearer token per client (openssl rand -hex 32). Leave one empty to lock that client out; at least one must be set
TRAINING_TOKEN_CLAUDE_AI=
TRAINING_TOKEN_CLAUDE_CODE=
# Cosine similarity a Chunk must reach to count as relevant. Belongs to EMBEDDING_MODEL: calibrate it with Negative Questions
TRAINING_SEARCH_MINIMUM_SIMILARITY=0.5
TRAINING_SEARCH_TOOL_DESCRIPTION="Searches the User's training Collection (Obsidian Notes and Source Notes on endurance training, climbing and bouldering, and physiotherapy). 'query' is the question in your own words (vector search, works across German and English). 'keywords' are optional exact terms for the full-text search (exercise names, abbreviations, proper names), all of which must occur; without them the full-text search uses 'query'. Set 'topic' when the subject is clear, e.g. Endurance, Climbing-Bouldering or Physio. Cite the Note path of every hit you use."
